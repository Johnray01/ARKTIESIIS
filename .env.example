NODE_ENV=development
PORT=3000
# Production requires a unique random secret with at least 32 characters.
SESSION_SECRET=replace-with-a-long-random-secret
# Password-only authentication is a development-only Phase 2 path.
DEV_PASSWORD_ONLY_LOGIN=false

# Microsoft SQL Server
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=ARKTIESIIS
DB_USER=sa
# Review Microsoft's SQL Server license terms before setting ACCEPT_EULA=Y.
ACCEPT_EULA=
# Set a unique local password before starting Compose.
DB_PASSWORD=
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# Email / 2FA. Set a real SMTP host before using email login outside the gated dev bypass.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
# Set both SMTP_USER and SMTP_PASS when the mail server requires authentication.
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ARKTIESIIS <no-reply@example.com>"

# Local OCR utilities. Paths may contain spaces; each executable is launched directly without a shell.
TESSERACT_PATH=tesseract
PDFINFO_PATH=pdfinfo
PDFTOPPM_PATH=pdftoppm
OCR_LANGUAGE=eng
OCR_TIMEOUT_MS=60000
OCR_CONCURRENCY=2
OCR_MAX_PDF_PAGES=20
# Rendered pages are capped at 1800 pixels and OCR output at 4 MiB.

# Uploads
MAX_UPLOAD_MB=10
DOCUMENT_STORAGE_DIR=storage/uploads
