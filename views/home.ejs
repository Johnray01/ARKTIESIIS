<%- include('partials/head', { title }) %>
<main class="page-shell home-page" id="main-content">
  <section class="home-intro" aria-labelledby="home-title">
    <h1 id="home-title">School information for the Lucena Branch.</h1>
    <p>ARKTIESIIS is the web-based information management system for Ark Technological Institute Education System Incorporated.</p>
    <section class="home-access" aria-labelledby="access-title">
      <h2 id="access-title">School account</h2>
      <p>Sign in with your school account to continue.</p>
      <a class="button button--primary" href="/login">Sign in</a>
    </section>
  </section>
  <figure class="home-visual">
    <img src="/images/arktiesiis-campus-building-hero.png" alt="Street view of the Ark Technological Institute Education System Incorporated building at Lucena Branch, with its blue glass facade and ARK sign visible." width="1672" height="941" fetchpriority="high">
    <figcaption>Ark Technological Institute Education System Incorporated · Lucena Branch</figcaption>
  </figure>
</main>
<%- include('partials/foot') %>
