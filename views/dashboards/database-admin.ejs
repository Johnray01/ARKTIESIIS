<%- include('../partials/head', { title }) %>
<main class="page-shell dashboard-page admin-page" id="main-content">
  <section class="dashboard-heading">
    <div>
      <h1>Database administration</h1>
      <p>Signed in as <%= currentUser.email %></p>
    </div>
  </section>

  <% if (notice) { %><p class="form-success" role="status"><%= notice %></p><% } %>

  <% if (summary) { %>
    <section class="dashboard-summary" aria-label="System summary">
      <dl class="dashboard-summary-grid">
        <div><dt>Active accounts</dt><dd><%= summary.active_user_count %></dd></div>
        <div><dt>Inactive accounts</dt><dd><%= summary.inactive_user_count %></dd></div>
        <div><dt>Active student records</dt><dd><%= summary.active_student_count %></dd></div>
        <div><dt>Archived student records</dt><dd><%= summary.archived_student_count %></dd></div>
        <div><dt>Documents awaiting staff review</dt><dd><%= summary.documents_awaiting_review_count %></dd></div>
      </dl>
    </section>
  <% } %>

  <section class="admin-section" aria-labelledby="users-title">
    <div class="admin-section__heading">
      <div>
        <h2 id="users-title">User accounts</h2>
        <p>Search by email or student number. Results are limited to 250 accounts.</p>
      </div>
      <a class="button button--secondary" href="/admin/users/new">Add user</a>
    </div>
    <% if (searchError) { %><p class="form-alert" role="alert"><%= searchError %></p><% } %>
    <form class="admin-search" method="get" action="/admin">
      <div class="field">
        <label for="account-search">Email or student number</label>
        <input id="account-search" name="search" type="search" maxlength="100" value="<%= searchTerm %>" autocomplete="off">
      </div>
      <button class="button button--secondary" type="submit">Search accounts</button>
      <% if (searchTerm) { %><a class="table-action" href="/admin">Clear search</a><% } %>
    </form>
    <p class="admin-result-count"><%= users.length %> matching account<%= users.length === 1 ? '' : 's' %><% if (users.length === 250) { %> (showing the newest 250)<% } %></p>
    <% if (users.length) { %>
      <div class="table-scroll" tabindex="0" aria-label="Scrollable user accounts table">
        <table class="admin-table">
          <caption class="visually-hidden">User accounts and access status</caption>
          <thead><tr><th scope="col">Name</th><th scope="col">Email</th><th scope="col">Role</th><th scope="col">Status</th><th scope="col">Created</th><th scope="col"><span class="visually-hidden">Account actions</span></th></tr></thead>
          <tbody>
            <% for (const user of users) { %>
              <tr>
                <td data-label="Name"><%= user.display_name %></td>
                <td data-label="Email"><%= user.email %></td>
                <td data-label="Role"><%= user.role.replaceAll('_', ' ').replace(/\b\w/g, (letter) => letter.toUpperCase()) %></td>
                <td data-label="Status"><span class="account-status <%= user.is_active ? 'account-status--active' : 'account-status--inactive' %>"><%= user.is_active ? 'Active' : 'Inactive' %></span></td>
                <td data-label="Created"><%= user.created_at ? new Date(user.created_at).toLocaleDateString() : '—' %></td>
                <td data-label="Actions"><a class="table-action" href="/admin/users/<%= user.id %>/edit">Manage</a></td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <p class="empty-state">No user accounts are available.</p>
    <% } %>
  </section>

  <section class="admin-section" aria-labelledby="audit-title">
    <div class="admin-section__heading">
      <div>
        <h2 id="audit-title">Recent audit activity</h2>
        <p>Latest 100 recorded actions. Sensitive event details are not shown here.</p>
      </div>
    </div>
    <% if (auditLogs.length) { %>
      <div class="table-scroll" tabindex="0" aria-label="Scrollable audit activity table">
        <table class="admin-table">
          <caption class="visually-hidden">Recent system audit activity</caption>
          <thead><tr><th scope="col">When</th><th scope="col">Actor</th><th scope="col">Action</th><th scope="col">Record</th></tr></thead>
          <tbody>
            <% for (const event of auditLogs) { %>
              <tr>
                <td data-label="When"><%= event.created_at ? new Date(event.created_at).toLocaleString() : '—' %></td>
                <td data-label="Actor"><%= event.actor_email || `User ${event.user_id || 'system'}` %></td>
                <td data-label="Action"><%= (event.action || 'Unknown').replaceAll('.', ' · ').replaceAll('_', ' ').replace(/^\w/, (letter) => letter.toUpperCase()) %></td>
                <td data-label="Record"><%= event.entity_type || '—' %><%= event.entity_id ? ` #${event.entity_id}` : '' %></td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <p class="empty-state">No audit events have been recorded.</p>
    <% } %>
  </section>
</main>
<%- include('../partials/foot') %>
