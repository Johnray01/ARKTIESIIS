<%- include('../partials/head', { title }) %>
<main class="page-shell dashboard-page admin-page records-page" id="main-content">
  <section class="dashboard-heading">
    <div>
      <h1>Academic record</h1>
      <p><%= student.student_no %> · <%= [student.first_name, student.middle_name, student.last_name, student.suffix].filter(Boolean).join(' ') %></p>
    </div>
    <div class="admin-heading-actions">
      <a class="button button--secondary" href="/records/students/<%= student.id %>/edit">Student profile</a>
      <a class="button button--secondary" href="/records/subjects">Subject catalog</a>
      <a class="button button--secondary" href="/records">Student records</a>
      <form method="post" action="/logout"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button button--secondary" type="submit">Sign out</button></form>
    </div>
  </section>
  <% if (notice) { %><p class="form-success" role="status"><%= notice %></p><% } %>
  <% if (error) { %><p class="form-alert" role="alert"><%= error %></p><% } %>

  <section class="admin-section" aria-labelledby="student-info-title">
    <div class="admin-section__heading"><div><h2 id="student-info-title">Student information</h2><p>Profile details and enrollment history for this student.</p></div></div>
    <dl class="student-profile-grid">
      <div><dt>Student number</dt><dd><%= student.student_no %></dd></div>
      <div><dt>Name</dt><dd><%= [student.first_name, student.middle_name, student.last_name, student.suffix].filter(Boolean).join(' ') %></dd></div>
      <div><dt>Status</dt><dd><%= student.status %></dd></div>
      <div><dt>Phone</dt><dd><%= student.phone || 'Not provided' %></dd></div>
      <div><dt>Address</dt><dd><%= student.address || 'Not provided' %></dd></div>
    </dl>
  </section>

  <section class="admin-section" aria-labelledby="enrollment-history-title">
    <div class="admin-section__heading"><div><h2 id="enrollment-history-title">Enrollment history</h2><p>Subjects and grades are kept with the existing enrollment they belong to.</p></div></div>
    <% if (enrollments.length) { %>
      <% for (const enrollment of enrollments) { %>
        <article class="academic-enrollment" aria-labelledby="enrollment-<%= enrollment.id %>-title">
          <h3 id="enrollment-<%= enrollment.id %>-title"><%= enrollment.school_year %> · <%= enrollment.term %></h3>
          <p class="muted-copy"><%= enrollment.section_name || 'No section assigned' %> · <%= enrollment.enrollment_status %><%= enrollment.is_current ? ' · Current term' : '' %></p>
          <% if (enrollment.subjects.length) { %>
            <div class="academic-subject-list">
              <% for (const assignment of enrollment.subjects) { %>
                <section class="academic-subject" aria-labelledby="assignment-<%= assignment.id %>-title">
                  <div class="admin-section__heading"><div><h4 id="assignment-<%= assignment.id %>-title"><%= assignment.subject_code %> · <%= assignment.subject_name %></h4><p><%= assignment.units ?? 'Units not set' %></p></div></div>
                  <% if (assignment.grades.length) { %>
                    <div class="academic-grade-list">
                      <% for (const grade of assignment.grades) { %>
                        <div class="academic-grade-item">
                          <div><strong><%= grade.gradingPeriod %></strong><span>Grade: <%= grade.gradeValue ?? 'Pending' %><% if (grade.remarks) { %> · <%= grade.remarks %><% } %></span></div>
                          <% if (currentUser.role === 'registrar') { %>
                            <form class="academic-grade-form" method="post" action="/records/grades">
                              <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="studentId" value="<%= student.id %>"><input type="hidden" name="studentSubjectId" value="<%= assignment.id %>"><input type="hidden" name="gradeId" value="<%= grade.id %>">
                              <div class="field"><label for="grade-period-<%= grade.id %>">Grading period</label><input id="grade-period-<%= grade.id %>" name="gradingPeriod" type="text" maxlength="50" required value="<%= grade.gradingPeriod %>"></div>
                              <div class="field"><label for="grade-value-<%= grade.id %>">Grade (0–100)</label><input id="grade-value-<%= grade.id %>" name="gradeValue" type="number" min="0" max="100" step="0.01" value="<%= grade.gradeValue ?? '' %>"></div>
                              <div class="field"><label for="grade-remarks-<%= grade.id %>">Remarks (optional)</label><input id="grade-remarks-<%= grade.id %>" name="remarks" type="text" maxlength="100" value="<%= grade.remarks || '' %>"></div>
                              <button class="button button--secondary" type="submit">Update grade</button>
                            </form>
                          <% } %>
                        </div>
                      <% } %>
                    </div>
                  <% } else { %><p class="empty-state">No grades recorded for this subject.</p><% } %>
                  <% if (currentUser.role === 'registrar') { %>
                    <form class="academic-grade-form academic-grade-form--new" method="post" action="/records/grades">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="studentId" value="<%= student.id %>"><input type="hidden" name="studentSubjectId" value="<%= assignment.id %>">
                      <div class="field"><label for="new-grade-period-<%= assignment.id %>">Grading period</label><input id="new-grade-period-<%= assignment.id %>" name="gradingPeriod" type="text" maxlength="50" required></div>
                      <div class="field"><label for="new-grade-value-<%= assignment.id %>">Grade (0–100)</label><input id="new-grade-value-<%= assignment.id %>" name="gradeValue" type="number" min="0" max="100" step="0.01"></div>
                      <div class="field"><label for="new-grade-remarks-<%= assignment.id %>">Remarks (optional)</label><input id="new-grade-remarks-<%= assignment.id %>" name="remarks" type="text" maxlength="100"></div>
                      <button class="button button--primary" type="submit">Save grade</button>
                    </form>
                  <% } %>
                </section>
              <% } %>
            </div>
          <% } else { %><p class="empty-state">No subjects are assigned to this enrollment.</p><% } %>
          <% if (currentUser.role === 'registrar') { %>
            <form class="form-stack records-enrollment-form academic-assignment-form" method="post" action="/records/student-subjects">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="studentId" value="<%= student.id %>"><input type="hidden" name="enrollmentId" value="<%= enrollment.id %>">
              <h4>Assign a subject</h4>
              <div class="field"><label for="subject-for-enrollment-<%= enrollment.id %>">Subject</label><select id="subject-for-enrollment-<%= enrollment.id %>" name="subjectId" required><option value="">Choose a subject</option><% for (const subject of subjects) { %><option value="<%= subject.id %>"><%= subject.subject_code %> · <%= subject.subject_name %></option><% } %></select></div>
              <button class="button button--primary button--align-start" type="submit" <%= subjects.length ? '' : 'disabled' %>>Assign subject</button>
            </form>
          <% } %>
        </article>
      <% } %>
    <% } else { %><p class="empty-state">This student has no enrollments. Create an enrollment from the student profile before assigning subjects.</p><% } %>
  </section>
</main>
<%- include('../partials/foot') %>
