<%- include('../partials/head', { title }) %>
<main class="page-shell dashboard-page admin-page records-page" id="main-content">
  <section class="dashboard-heading">
    <div>
      <h1>Subject catalog</h1>
      <p>Maintain the subjects available for student enrollments.</p>
    </div>
    <div class="admin-heading-actions">
      <a class="button button--secondary" href="/records">Student records</a>
      <form method="post" action="/logout"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button button--secondary" type="submit">Sign out</button></form>
    </div>
  </section>
  <% if (notice) { %><p class="form-success" role="status"><%= notice %></p><% } %>
  <% if (error) { %><p class="form-alert" role="alert"><%= error %></p><% } %>

  <% if (currentUser.role === 'registrar') { %>
    <section class="admin-form-section records-form-section" aria-labelledby="new-subject-title">
      <h2 id="new-subject-title">Add subject</h2>
      <p>Subject codes are stored in uppercase. Units are optional.</p>
      <form class="form-stack admin-form" method="post" action="/records/subjects">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="admin-form-grid">
          <div class="field"><label for="subject-code">Subject code</label><input id="subject-code" name="subjectCode" type="text" maxlength="50" required value="<%= values.subjectCode %>"></div>
          <div class="field"><label for="subject-name">Subject name</label><input id="subject-name" name="subjectName" type="text" maxlength="200" required value="<%= values.subjectName %>"></div>
          <div class="field"><label for="subject-units">Units (optional)</label><input id="subject-units" name="units" type="number" min="0.01" max="999.99" step="0.01" value="<%= values.units %>"></div>
        </div>
        <button class="button button--primary button--align-start" type="submit">Add subject</button>
      </form>
    </section>
  <% } %>

  <section class="admin-section" aria-labelledby="catalog-title">
    <div class="admin-section__heading"><div><h2 id="catalog-title">Catalog</h2><p><%= subjects.length %> subject<%= subjects.length === 1 ? '' : 's' %></p></div></div>
    <% if (subjects.length) { %>
      <div class="table-scroll" tabindex="0" aria-label="Subject catalog">
        <table class="admin-table"><thead><tr><th scope="col">Code</th><th scope="col">Name</th><th scope="col">Units</th><% if (currentUser.role === 'registrar') { %><th scope="col">Update</th><% } %></tr></thead>
          <tbody><% for (const subject of subjects) { %><tr>
            <% if (currentUser.role === 'registrar') { %>
              <td data-label="Code"><label class="visually-hidden" for="subject-code-<%= subject.id %>">Code for <%= subject.subject_name %></label><input id="subject-code-<%= subject.id %>" form="subject-form-<%= subject.id %>" name="subjectCode" type="text" maxlength="50" required value="<%= subject.subject_code %>"></td>
              <td data-label="Name"><label class="visually-hidden" for="subject-name-<%= subject.id %>">Name</label><input id="subject-name-<%= subject.id %>" form="subject-form-<%= subject.id %>" name="subjectName" type="text" maxlength="200" required value="<%= subject.subject_name %>"></td>
              <td data-label="Units"><label class="visually-hidden" for="subject-units-<%= subject.id %>">Units</label><input id="subject-units-<%= subject.id %>" form="subject-form-<%= subject.id %>" name="units" type="number" min="0.01" max="999.99" step="0.01" value="<%= subject.units ?? '' %>"></td>
              <td data-label="Update"><form id="subject-form-<%= subject.id %>" method="post" action="/records/subjects/<%= subject.id %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="table-action table-button" type="submit">Save</button></form></td>
            <% } else { %>
              <td data-label="Code"><%= subject.subject_code %></td><td data-label="Name"><%= subject.subject_name %></td><td data-label="Units"><%= subject.units ?? '—' %></td>
            <% } %>
          </tr><% } %></tbody>
        </table>
      </div>
    <% } else { %><p class="empty-state">No subjects have been added.</p><% } %>
  </section>
</main>
<%- include('../partials/foot') %>
