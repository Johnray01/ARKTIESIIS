<%- include('partials/head', { title }) %>
<main class="page-shell status-page" id="main-content">
  <section class="status-content" aria-labelledby="status-title">
    <h1 id="status-title"><%= title %></h1>
    <p><%= message %></p>
    <% const recovery = typeof errorRecovery !== 'undefined' && errorRecovery
      ? errorRecovery
      : title === 'Not Found'
        ? { href: '/', label: 'Return to home' }
        : { href: '/login', label: 'Return to sign in' }; %>
    <a class="button button--primary" href="<%= recovery.href %>"><%= recovery.label %></a>
  </section>
</main>
<%- include('partials/foot') %>
