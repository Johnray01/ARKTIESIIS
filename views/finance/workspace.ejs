<%- include('../partials/head', { title }) %>
<main class="page-shell dashboard-page finance-page <%= student ? 'finance-detail-page' : 'finance-workspace-page' %>" id="main-content">
  <% if (student) { %><a class="context-back" href="/finance<%= searchSuffix %>">Back to finance workspace</a><% } %>
  <section class="dashboard-heading">
    <div>
      <h1><%= student ? 'Financial account' : 'Finance workspace' %></h1>
      <p><%= student ? 'Review this student account and its recorded transactions.' : 'Review account activity, find a student, and record finance transactions.' %></p>
    </div>
  </section>

  <% if (notice) { %><p class="form-success" role="status"><%= notice %></p><% } %>
  <% if (error) { %><p class="form-alert" role="alert"><%= error %></p><% } %>
  <% if (student?.status === 'archived') { %>
    <p class="form-alert" role="status">This student record is archived. Existing financial account and transaction history is available for review; new accounts and transactions are disabled.</p>
  <% } %>

  <% if (!student) { %>
    <% if (summary) { %>
      <section class="dashboard-summary finance-dashboard-summary" aria-label="Finance summary">
        <div class="finance-summary-heading">
          <div><span class="finance-summary-eyebrow">Account overview</span><h2>Finance at a glance</h2></div>
          <p>Current account totals from saved finance records.</p>
        </div>
        <dl class="dashboard-summary-grid">
          <div><dt>Financial accounts</dt><dd><%= summary.account_count %></dd></div>
          <div><dt>Accounts with a balance due</dt><dd><%= summary.accounts_due_count %></dd></div>
          <div><dt>Settled accounts</dt><dd><%= summary.accounts_settled_count %></dd></div>
          <div><dt>Accounts with a credit balance</dt><dd><%= summary.accounts_credit_count %></dd></div>
        </dl>
        <div class="finance-summary-activity" aria-label="Ledger activity counts">
          <span>Ledger activity</span>
          <span><strong><%= summary.charge_count %></strong> recorded charges</span>
          <span><strong><%= summary.payment_count %></strong> recorded payments</span>
        </div>
      </section>
    <% } %>
    <% const accountRows = searchTerm ? students : recentAccounts; %>
    <section class="finance-panel finance-overview-panel" aria-labelledby="finance-search-heading">
      <div class="finance-overview-heading">
        <div>
          <span class="finance-eyebrow">Account index</span>
          <h2 id="finance-search-heading"><%= searchTerm ? 'Search results' : 'Recently updated accounts' %></h2>
          <p><%= searchTerm ? 'Matches across active and archived student records.' : 'The latest account activity. Search to find any student record.' %></p>
        </div>
        <form class="finance-search" method="get" action="/finance">
          <label class="field">
            <span>Student number or name</span>
            <input type="search" name="search" maxlength="100" value="<%= searchTerm %>" autocomplete="off" placeholder="e.g. DEMO-001" required>
          </label>
          <button class="button button--primary" type="submit">Search</button>
        </form>
      </div>
      <% if (searchError) { %><p class="form-alert" role="alert"><%= searchError %></p><% } %>
      <% if (searchTerm && !searchError && students.length === 0) { %><p class="empty-state">No matching students were found. Check the name or student number and search again.</p><% } %>
      <% if (accountRows.length) { %>
        <div class="table-scroll finance-account-list" tabindex="0" aria-label="<%= searchTerm ? 'Finance search results' : 'Recent financial accounts' %>">
          <table class="admin-table finance-overview-table">
            <caption class="visually-hidden"><%= searchTerm ? 'Student search results and account summary' : 'Recently updated student financial accounts' %></caption>
            <thead><tr><th scope="col">Student number</th><th scope="col">Student</th><th scope="col">Account status</th><th scope="col">Balance</th><th scope="col"><span class="visually-hidden">Action</span></th></tr></thead>
            <tbody>
              <% accountRows.forEach((result) => { %>
                <% const balanceAmount = result.balance === null || result.balance === undefined ? null : Number(result.balance); %>
                <% const accountStatus = !result.financial_account_id ? 'Not created' : balanceAmount > 0 ? 'Due' : balanceAmount < 0 ? 'Credit' : 'Settled'; %>
                <tr>
                  <td data-label="Student number"><%= result.student_no %></td>
                  <td data-label="Student"><%= [result.first_name, result.middle_name, result.last_name, result.suffix].filter(Boolean).join(' ') %></td>
                  <td data-label="Account status"><span class="finance-status finance-status--<%= accountStatus.toLowerCase().replaceAll(' ', '-') %>"><%= accountStatus %></span></td>
                  <td data-label="Balance"><%= balanceAmount === null ? '—' : `PHP ${result.balance}` %></td>
                  <td data-label="Action"><a class="table-action" href="/finance/students/<%= result.student_id %><%= searchSuffix %>"><%= result.financial_account_id ? 'View account' : 'Create account' %></a></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
        <p class="finance-caption"><%= searchTerm ? `Showing at most ${students.length === 100 ? '100' : students.length} matches.` : `Showing ${recentAccounts.length} of the most recently updated accounts.` %> Search covers all student records.</p>
      <% } else if (!searchTerm && !searchError) { %>
        <p class="empty-state">No financial accounts are available yet. Search for a student to create an account.</p>
      <% } %>
    </section>
  <% } %>

  <% if (student) { %>
    <section class="finance-panel finance-account" aria-labelledby="finance-account-heading">
      <div class="finance-account__heading">
        <div>
          <h2 id="finance-account-heading"><%= [student.first_name, student.middle_name, student.last_name, student.suffix].filter(Boolean).join(' ') %></h2>
          <p>Student number: <strong><%= student.student_no %></strong></p>
        </div>
        <% if (account) { %>
          <div class="finance-balance">
            <span>Current balance (PHP)</span>
            <strong><%= account.balance %></strong>
            <span><%= Number(account.balance) === 0 ? 'Settled' : String(account.balance).startsWith('-') ? 'Credit' : 'Due' %></span>
          </div>
        <% } %>
      </div>

      <% if (!account) { %>
        <div class="finance-empty">
          <h3>No financial account exists</h3>
          <% if (student.status === 'archived') { %>
            <p>A financial account cannot be created for an archived student record.</p>
          <% } else { %>
            <p>Create an account to begin recording charges, payments, and signed adjustments.</p>
            <form method="post" action="/finance/students/<%= student.student_id %>/account<%= searchSuffix %>" data-submitting-message="Creating the financial account. Please wait.">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="button button--primary" type="submit">Create financial account</button>
            </form>
          <% } %>
        </div>
      <% } else { %>
        <div class="finance-grid finance-detail-grid">
          <section aria-labelledby="finance-entry-heading">
            <h3 id="finance-entry-heading"><%= student.status === 'archived' ? 'Transactions are read-only' : 'Record a transaction' %></h3>
            <% if (student.status === 'archived') { %>
              <p>New transactions are disabled for archived student records.</p>
            <% } else { %>
            <form class="form-stack finance-entry" method="post" action="/finance/students/<%= student.student_id %>/transactions<%= searchSuffix %>" data-submitting-message="Recording the finance transaction. Please wait.">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <label class="field">
                <span>Transaction type</span>
                <select name="transactionType" required>
                  <option value="" <%= !transactionValues.transactionType ? 'selected' : '' %>>Choose a type</option>
                  <option value="charge" <%= transactionValues.transactionType === 'charge' ? 'selected' : '' %>>Charge (increases balance)</option>
                  <option value="payment" <%= transactionValues.transactionType === 'payment' ? 'selected' : '' %>>Payment (decreases balance)</option>
                  <option value="adjustment" <%= transactionValues.transactionType === 'adjustment' ? 'selected' : '' %>>Adjustment (signed amount)</option>
                </select>
              </label>
              <label class="field">
                <span>Amount (PHP)</span>
                <input type="text" name="amount" inputmode="decimal" maxlength="14" placeholder="1250.00 or -125.50" value="<%= transactionValues.amount %>" required aria-describedby="finance-amount-help">
                <small id="finance-amount-help">Use up to two decimal places. Adjustments may be positive or negative.</small>
              </label>
              <label class="field">
                <span>Description <span class="field__optional">(optional for charges and payments; required for adjustments)</span></span>
                <textarea name="description" rows="3" maxlength="500"><%= transactionValues.description %></textarea>
                <small>Adjustments require a description that explains the reason.</small>
              </label>
              <label class="field">
                <span>Reference number <span class="field__optional">(optional)</span></span>
                <input type="text" name="referenceNo" maxlength="100" value="<%= transactionValues.referenceNo %>">
                <small>A reference may be used once per account. SQL Server collation determines case matching.</small>
              </label>
              <button class="button button--primary" type="submit">Record transaction</button>
            </form>
            <% } %>
          </section>

          <section aria-labelledby="finance-history-heading">
            <h3 id="finance-history-heading">Recent transaction history</h3>
            <% if (!transactions.length) { %>
              <p class="finance-empty-copy">No transactions have been recorded.</p>
            <% } else { %>
              <div class="table-scroll" tabindex="0" role="region" aria-label="Scrollable transaction history for <%= student.student_no %>">
                <table class="admin-table finance-table finance-history-table">
                  <caption class="visually-hidden">Recent financial transactions for <%= student.student_no %></caption>
                  <thead><tr><th scope="col">Date</th><th scope="col">Type</th><th scope="col">Amount</th><th scope="col">Description / reference</th><th scope="col">Recorded by</th></tr></thead>
                  <tbody>
                    <% transactions.forEach((entry) => { %>
                      <tr>
                        <td data-label="Date"><%= entry.created_at ? new Date(entry.created_at).toLocaleString() : '' %></td>
                        <td data-label="Type"><%= entry.transaction_type ? entry.transaction_type.replaceAll('_', ' ').replace(/^\w/, (letter) => letter.toUpperCase()) : 'Unknown' %></td>
                        <td data-label="Amount">PHP <%= entry.amount %></td>
                        <td data-label="Description / reference"><%= [entry.description, entry.reference_no].filter(Boolean).join(' · ') || '—' %></td>
                        <td data-label="Recorded by"><%= entry.recorded_by_name %></td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
              <p class="finance-caption">Showing the latest 100 transactions.</p>
            <% } %>
          </section>
        </div>
      <% } %>
    </section>
  <% } %>
</main>
<%- include('../partials/foot') %>
